PORT=8787
PUBLIC_BASE_URL=https://squadlive.onrender.com
DEEPSEEK_API_KEY=
ADMIN_TOKEN=change-this-admin-token
APPLE_BUNDLE_ID=com.liuzhigang.AI-Live-Streaming
APPLE_APP_ID=
APPLE_AUTH_AUDIENCE=com.liuzhigang.AI-Live-Streaming
APPLE_IAP_ONLINE_CHECKS=false
IP_GEOLOCATION_ENABLED=true
IP_GEOLOCATION_BASE_URL=https://ipwho.is
# Optional Smart Cleaner daily subscription reconciliation (08:00 Asia/Shanghai).
# Use a key authorised for com.hecathehe.PhoneCleaner. Never put it in admin JS.
CLEANER_APPLE_IAP_KEY_ID=
CLEANER_APPLE_IAP_ISSUER_ID=
CLEANER_APPLE_IAP_PRIVATE_KEY=
# AppLovin advertiser acquisition costs (not MAX publisher revenue).
# Set currency to the verified account report currency; never expose the key in admin JS.
# Enabling sync refreshes the previous 7 complete UTC days at 08:00 Asia/Shanghai.
CLEANER_APPLOVIN_REPORT_KEY=
CLEANER_APPLOVIN_CURRENCY=
CLEANER_APPLOVIN_SYNC_ENABLED=false
